{
  "name": "markompose",
  "version": "0.1.1",
  "description": "A Markdown composer element that renders WYSIWYG while editing plain Markdown source.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emilbroman/markompose.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/markompose.js",
  "module": "./dist/markompose.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/markompose.js"
    },
    "./lezer": {
      "types": "./dist/lezer.d.ts",
      "import": "./dist/lezer.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "changeset": "changeset",
    "version:packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "prepack": "npm run build",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5"
  },
  "peerDependenciesMeta": {
    "@lezer/common": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/rust": "^1.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
