{
  "name": "markompose",
  "version": "0.0.0",
  "description": "A Markdown composer element that renders WYSIWYG while editing plain Markdown source.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/markompose.js",
  "module": "./dist/markompose.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/markompose.js"
    },
    "./lezer": {
      "types": "./dist/lezer.d.ts",
      "import": "./dist/lezer.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5"
  },
  "peerDependenciesMeta": {
    "@lezer/common": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/rust": "^1.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
